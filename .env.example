CITEPROOF_ENV=local
CITEPROOF_DATABASE_URL=postgresql+psycopg://citeproof:citeproof@localhost:5432/citeproof
CITEPROOF_EVAL_DATABASE_URL=postgresql+psycopg://citeproof:citeproof@localhost:5432/citeproof_eval
CITEPROOF_LOG_LEVEL=INFO
CITEPROOF_JOB_MAX_ATTEMPTS=3
CITEPROOF_JOB_BACKOFF_BASE_SECONDS=5.0
# Độ dài lease của job; worker gia hạn mỗi JOB_HEARTBEAT_SECONDS (phải nhỏ hơn nửa lease)
CITEPROOF_JOB_LOCK_TIMEOUT_SECONDS=120
CITEPROOF_JOB_HEARTBEAT_SECONDS=30.0
CITEPROOF_WORKER_POLL_INTERVAL_SECONDS=1.0
# Truy cập LLM (ADR-006). Không có khóa: mọi bước LLM giảm cấp tất định (cảnh báo LLM_NOT_CONFIGURED)
# CITEPROOF_ANTHROPIC_API_KEY=
CITEPROOF_ANTHROPIC_TIMEOUT_SECONDS=120.0
CITEPROOF_ANTHROPIC_MAX_RETRIES=2
# Worker gọi Sonnet/Opus bị từ chối thì server chạy lại trên model dự phòng
CITEPROOF_ANTHROPIC_REFUSAL_FALLBACK=true
CITEPROOF_LLM_CONCURRENCY=4
# JSON theo tác vụ (spec §8.2). Đặt biến là thay cả bảng; tác vụ không liệt kê dùng mặc định
# trong mã khi tạo lần chạy. Để comment thì dùng mặc định trong mã (giá trị dưới đây).
# CITEPROOF_LLM_MODELS={"reference.parse":"claude-haiku-5-5","claim.extract":"claude-haiku-5-5","claim.translate":"claude-haiku-5-5","claim.decompose":"claude-haiku-5-5","verdict.judge":"claude-sonnet-5-5","verdict.judge_closed_book":"claude-sonnet-5-5","agent.reference_resolver":"claude-sonnet-5-5","agent.evidence_investigator":"claude-sonnet-5-5"}
# CITEPROOF_LLM_EFFORT={"reference.parse":"low","claim.extract":"low","claim.translate":"low","claim.decompose":"low","verdict.judge":"high","verdict.judge_closed_book":"high","agent.reference_resolver":"high","agent.evidence_investigator":"high"}
# CITEPROOF_LLM_MAX_TOKENS={"reference.parse":8000,"claim.extract":4000,"claim.translate":2000,"claim.decompose":2000,"verdict.judge":16000,"verdict.judge_closed_book":16000,"agent.reference_resolver":16000,"agent.evidence_investigator":16000}
# JSON: {"<model>": [input_usd_per_1M, output_usd_per_1M]}; để comment thì dùng mặc định trong mã
# CITEPROOF_LLM_PRICES={"claude-haiku-5-5":[0.10,0.50],"claude-sonnet-5-5":[2.0,10.0],"claude-opus-5-5":[4.0,20.0]}
# Giới hạn một lần chạy và số đoạn truy xuất cho mỗi cặp; đóng băng vào cấu hình lần chạy khi tạo
CITEPROOF_RUN_MAX_CLAIMS=150
CITEPROOF_RUN_MAX_COST_USD=5.0
CITEPROOF_RETRIEVAL_K=6
# Parse PDF (ADR-004): GROBID là chính; để trống URL thì chỉ dùng pypdfium2 dự phòng (cảnh báo
# PDF_TEXT_FALLBACK). Trong docker compose, worker dùng http://grobid:8070.
CITEPROOF_GROBID_URL=http://localhost:8070
CITEPROOF_GROBID_TIMEOUT_SECONDS=300.0
# Bài có nhiều trang hơn bị từ chối ở bước nhận tài liệu (PAGE_LIMIT_EXCEEDED)
CITEPROOF_MAX_PAGES=300
# Tra cứu metadata ở S3 (Crossref, OpenAlex, Semantic Scholar). Email liên hệ của NGƯỜI VẬN HÀNH
# (không phải người dùng) cho "polite pool": gửi trong User-Agent và tham số mailto của OpenAlex.
# Để comment thì không gửi email nào.
# CITEPROOF_CONTACT_EMAIL=
# Tùy chọn; không có khóa thì Semantic Scholar giới hạn tốc độ chung rất thấp
# CITEPROOF_SEMANTIC_SCHOLAR_API_KEY=
# Tùy chọn nhưng nên đặt trước pilot: không có khóa, OpenAlex chỉ cho một hạn mức nhỏ mỗi ngày dùng
# chung cho mọi client cùng IP (khoảng 100 lượt tìm). Gửi làm tham số api_key, không bao giờ ghi log.
# CITEPROOF_OPENALEX_API_KEY=
# JSON số yêu cầu mỗi giây theo nguồn; nguồn không liệt kê dùng mặc định trong mã (giá trị dưới)
# CITEPROOF_METADATA_RATE_LIMITS={"crossref":5.0,"openalex":10.0,"semantic_scholar":0.3}
# Số lỗi liên tiếp của một nguồn trong một lần chạy trước khi ngắt mạch nguồn đó
CITEPROOF_METADATA_BREAKER_THRESHOLD=3
# Hạn của metadata_cache: kết quả tìm thấy / không tìm thấy (ngày)
CITEPROOF_METADATA_CACHE_TTL_DAYS=30
CITEPROOF_METADATA_NOT_FOUND_TTL_DAYS=7
CITEPROOF_METADATA_TIMEOUT_SECONDS=15.0
# Số tài liệu tham khảo kiểm tra song song trong một lần chạy
CITEPROOF_REFERENCE_CONCURRENCY=4
# Tra bản lưu trữ archive.org cho tài liệu web; chỉ bật khi màn hình đồng ý đã nêu archive.org
CITEPROOF_WEB_ARCHIVE_LOOKUP=false
# Giao diện web
CITEPROOF_STORAGE_DIR=var/storage
CITEPROOF_MAX_UPLOAD_BYTES=26214400
CITEPROOF_MAX_TEXT_CHARS=50000
CITEPROOF_MAX_REFERENCE_CHARS=20000
CITEPROOF_SESSION_TTL_DAYS=14
CITEPROOF_RUNS_PER_DAY=20
# Để trống: Secure cookie bật ở mọi môi trường trừ local
# CITEPROOF_COOKIE_SECURE=true
CITEPROOF_LOGIN_MAX_FAILURES_PER_EMAIL=5
CITEPROOF_LOGIN_MAX_FAILURES_PER_IP=20
CITEPROOF_LOGIN_WINDOW_MINUTES=15
CITEPROOF_CONSENT_TEXT_UPDATED_AT=2026-11-23T00:00:00Z
# Bắt buộc trước pilot (10 §5): hiển thị trên màn hình đồng ý
# CITEPROOF_LLM_PROVIDER_NAME=
# CITEPROOF_LLM_PROVIDER_POLICY_URL=
# IP reverse proxy được tin X-Forwarded-For (phân tách bằng dấu phẩy). Đặt khi chạy sau proxy ở pilot.
CITEPROOF_TRUSTED_PROXIES=127.0.0.1
